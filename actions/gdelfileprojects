: ${TODOTXT_GDELFILE_PROJECTS_SIGIL:=+}
: ${TODOTXT_GDELFILE_PROJECTS_WHAT:=+projects}

action=$1
shift

[ "$action" = "usage" ] && {
    echo "    $(basename $0) [SRC]"
    echo "      Delete all $TODOTXT_GDELFILE_PROJECTS_WHAT from ALL lines in todo.txt or SRC file."
    echo ""
    exit
}

errmsg="usage: $TODO_SH $(basename $0) [SRC]"

[ $# -le 1 ] || die "$errmsg"

TODOTXT_GDELFILE_WHOLE_WORD=t \
    exec "$TODO_FULL_SH" gdelfile "${TODOTXT_SIGIL_BEFORE_PATTERN}${TODOTXT_GDELFILE_PROJECTS_SIGIL}${TODOTXT_SIGIL_VALID_PATTERN}${TODOTXT_SIGIL_AFTER_PATTERN}" "$@"
